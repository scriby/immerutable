{
  "name": "immerutable",
  "description": "Scalable collections for Immer, inspired by ImmutableJS.",
  "version": "3.0.0",
  "devDependencies": {
    "@types/jest": "29.5.13",
    "@types/node": "22.5.5",
    "esbuild": "0.28.2",
    "google-closure-compiler": "20261108.0.0",
    "immer": "11.2.9",
    "jest": "29.7.0",
    "number-generator": "2.1.5",
    "source-map-support": "0.5.5",
    "ts-jest": "29.2.5",
    "typescript": "5.6.2"
  },
  "files": [
    "dist/src/**",
    "src/**",
    "tsconfig.json"
  ],
  "peerDependencies": {
    "immer": ">=10"
  },
  "license": "MIT",
  "main": "dist/src/index.js",
  "author": "Chris Scribner",
  "repository": {
    "type": "git",
    "url": "https://github.com/scriby/immerutable"
  },
  "scripts": {
    "check:types": "tsc --noEmit && tsc -p tsconfig.iterators.json --lib es2018 && tsc -p tsconfig.iterators.json",
    "test:ci": "jest src --runInBand",
    "check:browser": "node scripts/check-browser.mjs",
    "benchmark": "tsc && node --expose-gc dist/benchmark/benchmark.js",
    "benchmark:review": "tsc && node --expose-gc dist/benchmark/review.js",
    "benchmark:eviction": "tsc && node --expose-gc dist/benchmark/eviction.js",
    "benchmark-debug": "tsc && node --inspect-brk --expose-gc dist/benchmark/benchmark.js",
    "coverage": "jest src --coverage",
    "build": "rm -rf dist/* && tsc",
    "fuzz": "jest fuzz",
    "fuzz-coverage": "jest fuzz --coverage",
    "fuzz-debug": "node --inspect-brk ./node_modules/.bin/jest fuzz --runInBand",
    "test": "jest src --watch",
    "test-debug": "node --inspect-brk ./node_modules/.bin/jest src --runInBand --watch"
  },
  "jest": {
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testRegex": "((\\.|/)test)\\.ts$",
    "moduleFileExtensions": [
      "ts",
      "js",
      "json",
      "node"
    ]
  }
}
